<?xml version="1.0" encoding="utf-8"?>
<!--
  The Tracive SDK's own manifest. Everything here is merged into the host app automatically, which
  is the point: an integrator gets the package-visibility declaration and the context capture by
  depending on the AAR, with nothing to remember.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Package visibility (API 30+). Without a declaration here, PackageManager.getPackageInfo throws
    NameNotFoundException for the Tracive app even when it is installed — so the SDK's pre-check
    would report "not installed" for every user and send all of them to the install page.

    NO <package> ENTRY, deliberately. This file is merged into every partner's app, so a <package>
    entry here is an entry published in someone else's shipped manifest, and a bank auditing its
    merged manifest has to account for it. That went wrong once already; PublishedApplicationIdTest
    asserts the absence. Visibility comes from the authorize App Links below instead: they name
    hosts this SDK already names in AuthorizeUrlBuilder, and each grants visibility to whichever
    build claims that host, so the environment picks the build rather than anything written here.
  -->
  <queries>
    <!--
      Browsers, so Custom Tabs can resolve one. The authorize page is opened in the system browser
      and never in a WebView: an App Link does not fire from a WebView, and RFC 8252 §8.12 forbids
      embedded user-agents for OAuth.
    -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" />
    </intent>

    <!--
      The authorize App Link of each environment, host and path exactly as AuthorizeUrlBuilder
      spells them — a scheme-only query does not match a filter that declares a host, so these have
      to carry both. PublishedApplicationIdTest pins them against those constants so the manifest
      and the URL the SDK actually opens cannot drift apart.
    -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" android:host="tracive.id" android:path="/oauth/authorize" />
    </intent>

    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" android:host="sandbox.tracive.id" android:path="/oauth/authorize" />
    </intent>
  </queries>

  <application>
    <!--
      Captures the application Context before Application.onCreate returns. Not exported and it
      answers nothing; see TraciveInitProvider. A host that removes it must call
      TraciveAndroid.initialize(context) itself.

      The authority is namespaced with ${applicationId} so two apps with this SDK installed on one
      device do not collide — a duplicate provider authority fails the install outright.
    -->
    <provider
      android:name="id.tracive.sdk.TraciveInitProvider"
      android:authorities="${applicationId}.tracive-sdk-init"
      android:exported="false"
      android:initOrder="100"
      android:multiprocess="true" />

    <!--
      Serves the report package that openReportForm hands to the Tracive app, from
      cache/tracive-sdk/report/ only. Not exported: the Tracive app reads the one file through the
      read grant on the intent that names it, and nothing else can open this provider at all.

      Its own subclass and authority, so it neither collides with a host's FileProvider in the
      manifest merger nor with another Tracive SDK in the same app.
    -->
    <provider
      android:name="id.tracive.sdk.platform.TraciveFileProvider"
      android:authorities="${applicationId}.tracive-sdk-files"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/tracive_sdk_report_paths" />
    </provider>
  </application>

</manifest>
