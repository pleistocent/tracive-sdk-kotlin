<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <!--
    The home-screen label, and it has to be spelled out here. `CFBundleName` below resolves to
    PRODUCT_NAME, which this project leaves at `$(TARGET_NAME)` — so without this key the sample
    installs as "iosApp". A partner evaluating the SDK sees that name before anything else.

    Kept short on purpose. iOS tightens the tracking on a home-screen label that does not fit
    and then truncates it, and it tightens far enough that the spaces disappear: "Tracive SDK
    Sample" at 18 characters rendered as "TraciveSDKSa…", which reads like a typo rather than a
    long name. 15 characters still renders in full, so the ceiling is somewhere between the two.

    The name says the platform rather than repeating "SDK", which the icon's ribbon already
    carries — and "Tracive Flutter SDK", the matching name for the Flutter example, would be 19
    characters and land back in the broken range.

    Per flavor, from Config/*.xcconfig: "Tracive KMP" for Production, "KMP Sandbox" for Sandbox.
  -->
  <key>CFBundleDisplayName</key>
  <string>$(TRACIVE_DISPLAY_NAME)</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.2.2</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>UILaunchScreen</key>
  <dict/>

  <!--
    Required by Compose Multiplatform, and not optional in the "nice to have" sense: without it
    ComposeUIViewController throws on the first frame and the app never draws. It opts the app out
    of the 60fps cap on 120Hz iPhones — CADisplayLink otherwise refuses the higher rate, and Compose
    treats shipping an animation loop it knows will judder as an error rather than a warning.
  -->
  <key>CADisableMinimumFrameDurationOnPhone</key>
  <true/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>

  <!--
    Package visibility for the SDK's "is the Tracive app installed?" pre-check.

    Info.plist files are not merged, so unlike Android's <queries> this cannot ship inside the SDK
    — it has to be here. Without it, canOpenURL answers false on every device, installed or not,
    and every user is sent to the install page instead of the consent screen.

    `tracive` is the production app, `tracivesandbox` the sandbox build, and the probe follows
    `environment`. Listing both costs nothing and removes the failure where switching environment
    silently starts answering false.

    The `-report` entries are for openReportForm: a Tracive build that accepts the report package
    registers that scheme. Without them the Report button still opens Tracive, with the account only.

    The `tracivedev` pair is the sample's own, for the "Dev build (QA)" choice on its Report button.
    A partner app does not need it and should not ship it.
  -->
  <key>LSApplicationQueriesSchemes</key>
  <array>
    <string>tracive</string>
    <string>tracivesandbox</string>
    <string>tracive-report</string>
    <string>tracivesandbox-report</string>
    <string>tracivedev</string>
    <string>tracivedev-report</string>
  </array>

  <!--
    Which Tracive environment this build talks to, and the redirect the SDK is configured with.
    TraciveSample.ios.kt reads both. The redirect is assembled here from the same scheme that
    CFBundleURLTypes below registers, so the two cannot drift apart.
  -->
  <key>TraciveEnvironment</key>
  <string>$(TRACIVE_ENVIRONMENT)</string>
  <key>TraciveRedirectURI</key>
  <string>$(TRACIVE_REDIRECT_SCHEME)://oauth/callback</string>

  <!--
    The OAuth redirect target. The scheme is per flavor, set in Config/*.xcconfig.

    A private-use URI scheme, which RFC 8252 permits for a native app that controls no web domain.
    Any app on the device may declare the same scheme, so a partner who controls a domain should
    use a Universal Link instead — an `applinks:` entitlement plus an apple-app-site-association
    file on that host, which cannot be claimed by anyone else.

    TODO(partner): your own scheme in Config/*.xcconfig, or delete this block entirely and add the
    `applinks:` entitlement for a host you own, pointing TraciveRedirectURI above at it.
  -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>CFBundleURLName</key>
      <string>$(PRODUCT_BUNDLE_IDENTIFIER).oauth</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>$(TRACIVE_REDIRECT_SCHEME)</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
