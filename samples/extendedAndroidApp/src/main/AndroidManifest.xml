<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />

  <!-- The Tracive build this sample reports to. Change it in build.gradle.kts, not here. -->
  <queries>
    <package android:name="${traciveAppPackage}" />
  </queries>

  <application
      android:name=".SampleApp"
      android:allowBackup="false"
      android:icon="@mipmap/ic_launcher"
      android:label="${sampleLabel}"
      android:networkSecurityConfig="@xml/network_security_config"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:supportsRtl="true"
      android:theme="@android:style/Theme.Material.Light.NoActionBar">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask">

      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <!-- The OAuth redirect. Change the scheme and host in build.gradle.kts, not here. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data
            android:host="${traciveRedirectHost}"
            android:scheme="${traciveRedirectScheme}" />
      </intent-filter>
    </activity>
  </application>
</manifest>
